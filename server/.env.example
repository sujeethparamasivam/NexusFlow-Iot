PORT=5000
MONGO_URI=mongodb+srv://username:password@cluster.example.mongodb.net/
DB_NAME=nexusflow
CLIENT_URL=http://localhost:5173

# Minimum time between repeated alerts for the same device/action (5 minutes).
ALERT_COOLDOWN_MS=300000
JWT_SECRET=replace_with_a_long_random_secret

# Optional Twilio SMS delivery. Leave blank to use mock-sms only.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Gmail SMTP. Use a Gmail App Password, never your normal Gmail password.
EMAIL_USER=
EMAIL_APP_PASSWORD=

# Telegram Bot API. Keep both values server-side only.
TELEGRAM_BOT_TOKEN=
